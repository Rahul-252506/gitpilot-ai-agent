[TEMPLATE]
# =========================================================
# GitPilot — environment configuration
# Copy to backend/.env and fill in real values. Never commit .env.
# Placeholders only — real values stay out of version control.
# =========================================================

# GitHub access token (server-side only). Public-repo reads still need a
# token for code search. Create one at https://github.com/settings/tokens
# with at most `repo` scope (read) — write actions additionally need
# `issues:write` and are only executed after explicit user approval.
GITHUB_TOKEN=

# LLM provider: "gemini" (real), "openai" (real), or "mock"
# (deterministic offline demo).
LLM_PROVIDER=gemini

# OpenAI credentials (only required when LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini credentials (only required when LLM_PROVIDER=gemini).
# Get a key at https://aistudio.google.com/apikey — free tier works.
# "gemini-flash-latest" always tracks the current GA flash model; you can
# pin a specific version (e.g. gemini-3.6-flash) instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.2

# Agent safety limits.
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=300
TOOL_MAX_OUTPUT_CHARS=8000
STRUCTURED_OUTPUT_RETRIES=2

# GitHub API (override only for testing/proxies).
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15

# App
GITPILOT_DATABASE_PATH=gitpilot.db
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
GITPILOT_LOG_LEVEL=INFO

# =========================================================
# Frontend (copy to frontend/.env.local) — optional
# =========================================================
# Where the browser reaches the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
